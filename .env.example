# Copy to .env and provide a PostgreSQL / Neon connection string.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/carm?sslmode=verify-full
# Google Cloud OAuth client of type Web application.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe Billing: one inclusive EUR 25.00 monthly price per garage.
# Prefer a restricted key with Customers, Checkout, Subscriptions, Prices,
# Tax registrations and Billing Portal permissions. Never use a public key here.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Enable only after configuring Stripe Tax and your actual active registrations.
STRIPE_AUTOMATIC_TAX=false
# 32 random bytes encoded as 64 hexadecimal characters; keep stable and private.
# Required to enable TOTP. Losing/changing this key requires account recovery.
ACCOUNT_ENCRYPTION_KEY=
# Set these only to enable real, manually validated emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
