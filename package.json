{
  "name": "carm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server.ts",
    "build": "next build",
    "start": "node --disable-warning=ExperimentalWarning server.ts --production",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.ts",
    "db:import:sqlite": "node --disable-warning=ExperimentalWarning scripts/import-sqlite.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env.test --disable-warning=ExperimentalWarning --test tests/*.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
